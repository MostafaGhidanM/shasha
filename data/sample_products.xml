<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sample Products -->
        <record id="product_iphone_15_pro_max" model="product.template">
            <field name="name">iPhone 15 Pro Max</field>
            <field name="description_sale">The iPhone 15 Pro Max features a stunning titanium design, the powerful A17 Pro chip, and an advanced camera system with 5x telephoto zoom.</field>
            <field name="list_price">4999.00</field>
            <field name="standard_price">4200.00</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('category_iphone')])]"/>
            <field name="website_published" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="is_featured" eval="True"/>
            <field name="website_sequence">1</field>
            <field name="default_code">IP15PM256</field>
        </record>

        <record id="product_iphone_15" model="product.template">
            <field name="name">iPhone 15</field>
            <field name="description_sale">The iPhone 15 brings you Dynamic Island, a 48MP Main camera, and USB-C — all in a durable color-infused glass and aluminum design.</field>
            <field name="list_price">3399.00</field>
            <field name="compare_list_price">3599.00</field>
            <field name="standard_price">2850.00</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('category_iphone')])]"/>
            <field name="website_published" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="is_featured" eval="True"/>
            <field name="website_sequence">2</field>
            <field name="default_code">IP15128</field>
        </record>

        <record id="product_samsung_s24_ultra" model="product.template">
            <field name="name">Samsung Galaxy S24 Ultra</field>
            <field name="description_sale">Meet Galaxy S24 Ultra, the ultimate form of Galaxy Ultra with the new S Pen, the most mega zoom camera, and the power of AI.</field>
            <field name="list_price">4299.00</field>
            <field name="compare_list_price">4699.00</field>
            <field name="standard_price">3600.00</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('category_samsung')])]"/>
            <field name="website_published" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="is_featured" eval="True"/>
            <field name="website_sequence">3</field>
            <field name="default_code">SGS24U256</field>
        </record>

        <record id="product_airpods_pro_2" model="product.template">
            <field name="name">AirPods Pro (2nd Generation)</field>
            <field name="description_sale">AirPods Pro (2nd generation) with MagSafe Charging Case deliver 2x more Active Noise Cancellation than the previous generation.</field>
            <field name="list_price">899.00</field>
            <field name="standard_price">650.00</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('category_airpods')])]"/>
            <field name="website_published" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="is_featured" eval="True"/>
            <field name="website_sequence">4</field>
            <field name="default_code">APPRO2GEN</field>
        </record>

        <record id="product_apple_watch_s9" model="product.template">
            <field name="name">Apple Watch Series 9</field>
            <field name="description_sale">Apple Watch Series 9 features the S9 chip, a superbright display, and a magical new way to use your watch.</field>
            <field name="list_price">1599.00</field>
            <field name="standard_price">1200.00</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('category_smartwatches')])]"/>
            <field name="website_published" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="website_sequence">5</field>
            <field name="default_code">AWS945MM</field>
        </record>

        <record id="product_iphone_case" model="product.template">
            <field name="name">iPhone 15 Pro Silicone Case</field>
            <field name="description_sale">Designed by Apple to complement iPhone 15 Pro, the silicone case is a delightful way to protect your iPhone.</field>
            <field name="list_price">199.00</field>
            <field name="standard_price">80.00</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('category_cases')])]"/>
            <field name="website_published" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="website_sequence">6</field>
            <field name="default_code">IP15PCASE</field>
        </record>

        <!-- Product Attributes -->
        <record id="attribute_color" model="product.attribute">
            <field name="name">Color</field>
            <field name="sequence">1</field>
        </record>

        <record id="attribute_storage" model="product.attribute">
            <field name="name">Storage</field>
            <field name="sequence">2</field>
        </record>

        <!-- Color Attribute Values -->
        <record id="attribute_value_black" model="product.attribute.value">
            <field name="name">Black</field>
            <field name="attribute_id" ref="attribute_color"/>
            <field name="sequence">1</field>
        </record>

        <record id="attribute_value_white" model="product.attribute.value">
            <field name="name">White</field>
            <field name="attribute_id" ref="attribute_color"/>
            <field name="sequence">2</field>
        </record>

        <record id="attribute_value_blue" model="product.attribute.value">
            <field name="name">Blue</field>
            <field name="attribute_id" ref="attribute_color"/>
            <field name="sequence">3</field>
        </record>

        <!-- Storage Attribute Values -->
        <record id="attribute_value_128gb" model="product.attribute.value">
            <field name="name">128GB</field>
            <field name="attribute_id" ref="attribute_storage"/>
            <field name="sequence">1</field>
        </record>

        <record id="attribute_value_256gb" model="product.attribute.value">
            <field name="name">256GB</field>
            <field name="attribute_id" ref="attribute_storage"/>
            <field name="sequence">2</field>
        </record>

        <record id="attribute_value_512gb" model="product.attribute.value">
            <field name="name">512GB</field>
            <field name="attribute_id" ref="attribute_storage"/>
            <field name="sequence">3</field>
        </record>

        <!-- Delivery Methods -->
        <record id="delivery_standard" model="delivery.carrier">
            <field name="name">Standard Delivery</field>
            <field name="product_id" ref="product.product_product_delivery_01"/>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">0.0</field>
            <field name="website_published" eval="True"/>
            <field name="sequence">1</field>
        </record>

        <record id="delivery_express" model="delivery.carrier">
            <field name="name">Express Delivery</field>
            <field name="product_id" ref="product.product_product_delivery_02"/>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">25.0</field>
            <field name="website_published" eval="True"/>
            <field name="sequence">2</field>
        </record>

        <record id="delivery_same_day" model="delivery.carrier">
            <field name="name">Same Day Delivery</field>
            <field name="product_id" ref="product.product_product_delivery_02"/>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">50.0</field>
            <field name="website_published" eval="True"/>
            <field name="sequence">3</field>
        </record>

    </data>
</odoo>

