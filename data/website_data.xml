<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Website Configuration -->
        <record id="website_techdream_config" model="website">
            <field name="name">TechDream Mobile</field>
            <field name="domain">techdream.ae</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="language_ids" eval="[(6, 0, [ref('base.lang_en')])]"/>
            <field name="default_lang_id" ref="base.lang_en"/>
            <field name="auto_redirect_lang" eval="True"/>
            <field name="cookies_bar" eval="True"/>
        </record>

        <!-- Website Pages -->
        <record id="website_page_contact" model="website.page">
            <field name="name">Contact Us</field>
            <field name="is_published" eval="True"/>
            <field name="url">/contact</field>
            <field name="view_id" ref="contact_page_template"/>
            <field name="website_id" ref="website_techdream_config"/>
        </record>

        <!-- Website Menus -->
        <record id="website_menu_shop" model="website.menu">
            <field name="name">Shop</field>
            <field name="url">/shop</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="website_id" ref="website_techdream_config"/>
            <field name="sequence">20</field>
        </record>

        <record id="website_menu_smartphones" model="website.menu">
            <field name="name">Smartphones</field>
            <field name="url">/shop/smartphones</field>
            <field name="parent_id" ref="website_menu_shop"/>
            <field name="website_id" ref="website_techdream_config"/>
            <field name="sequence">10</field>
        </record>

        <record id="website_menu_accessories" model="website.menu">
            <field name="name">Accessories</field>
            <field name="url">/shop/accessories</field>
            <field name="parent_id" ref="website_menu_shop"/>
            <field name="website_id" ref="website_techdream_config"/>
            <field name="sequence">20</field>
        </record>

        <record id="website_menu_audio" model="website.menu">
            <field name="name">Audio</field>
            <field name="url">/shop/audio</field>
            <field name="parent_id" ref="website_menu_shop"/>
            <field name="website_id" ref="website_techdream_config"/>
            <field name="sequence">30</field>
        </record>

        <record id="website_menu_smartwatches" model="website.menu">
            <field name="name">Smartwatches</field>
            <field name="url">/shop/smartwatches</field>
            <field name="parent_id" ref="website_menu_shop"/>
            <field name="website_id" ref="website_techdream_config"/>
            <field name="sequence">40</field>
        </record>

        <record id="website_menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="website_id" ref="website_techdream_config"/>
            <field name="sequence">90</field>
        </record>

        <!-- Website Snippets and Theme Data -->
        <record id="website_snippet_hero" model="website.snippet">
            <field name="name">TechDream Hero Section</field>
            <field name="template_id" ref="techdream_homepage_enhanced"/>
            <field name="website_id" ref="website_techdream_config"/>
        </record>

    </data>
</odoo>