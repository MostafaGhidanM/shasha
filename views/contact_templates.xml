<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Contact Page Template -->
    <template id="contact_page_template" name="Contact Us">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- Breadcrumb -->
                <div class="breadcrumb-section">
                    <div class="container">
                        <div class="breadcrumb-nav">
                            <span class="breadcrumb-item">
                                <a href="/">Home</a>
                            </span>
                            <span class="breadcrumb-separator">/</span>
                            <span class="breadcrumb-item">Contact Us</span>
                        </div>
                    </div>
                </div>

                <!-- Hero Section -->
                <section class="contact-hero py-5" style="background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);">
                    <div class="container">
                        <div class="row text-center text-white">
                            <div class="col-12">
                                <h1 class="display-4 mb-4" style="font-weight: 700;">Get in Touch</h1>
                                <p class="lead">We're here to help with any questions about our products and services</p>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="container py-5">
                    <!-- Success/Error Messages -->
                    <div class="row" t-if="success or error">
                        <div class="col-12">
                            <div class="alert alert-success alert-dismissible fade show" t-if="success">
                                <i class="fas fa-check-circle me-2"></i>
                                Thank you for your message! We'll get back to you within 24 hours.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                            <div class="alert alert-danger alert-dismissible fade show" t-if="error">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                There was an error sending your message. Please try again or contact us directly.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Contact Form -->
                        <div class="col-lg-8 mb-5">
                            <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                                <h3 class="mb-4" style="color: #2c3e50;">Send us a Message</h3>

                                <form method="post" action="/contact/submit" id="contact-form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">First Name *</label>
                                            <input type="text" name="first_name" class="form-control" required="true"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Last Name *</label>
                                            <input type="text" name="last_name" class="form-control" required="true"/>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Email Address *</label>
                                            <input type="email" name="email" class="form-control" required="true"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Phone Number</label>
                                            <input type="tel" name="phone" class="form-control"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Subject *</label>
                                        <select name="subject" class="form-select" required="true">
                                            <option value="">Select Subject</option>
                                            <option value="general">General Inquiry</option>
                                            <option value="product">Product Question</option>
                                            <option value="order">Order Support</option>
                                            <option value="technical">Technical Support</option>
                                            <option value="return">Return/Exchange</option>
                                            <option value="wholesale">Wholesale Inquiry</option>
                                            <option value="partnership">Partnership</option>
                                        </select>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label">Message *</label>
                                        <textarea name="message" class="form-control" rows="6" placeholder="Tell us how we can help you..." required="true"></textarea>
                                    </div>

                                    <!-- Privacy Consent -->
                                    <div class="mb-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="privacy_consent" id="privacy_consent" required="true"/>
                                            <label class="form-check-label" for="privacy_consent">
                                                I agree to the <a href="/privacy-policy" target="_blank">Privacy Policy</a> and consent to the processing of my personal data.
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Newsletter Subscription -->
                                    <div class="mb-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="newsletter" id="newsletter"/>
                                            <label class="form-check-label" for="newsletter">
                                                Subscribe to our newsletter for latest updates and special offers
                                            </label>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        <i class="fas fa-paper-plane me-2"></i>
                                        Send Message
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="col-lg-4">
                            <!-- Contact Details -->
                            <div style="background: white; border-radius: 15px; padding: 30px; box-shadow: 0 8px 25px rgba(0,0,0,0.1); margin-bottom: 30px;">
                                <h4 class="mb-4" style="color: #2c3e50;">Contact Information</h4>

                                <div class="contact-item mb-4">
                                    <div class="d-flex align-items-center">
                                        <div style="width: 50px; height: 50px; background: #3498db; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                            <i class="fas fa-map-marker-alt" style="color: white;"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1" style="color: #2c3e50;">Address</h6>
                                            <p class="mb-0 text-muted">Sheikh Zayed Road<br/>
Dubai, UAE</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="contact-item mb-4">
                                    <div class="d-flex align-items-center">
                                        <div style="width: 50px; height: 50px; background: #27ae60; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                            <i class="fas fa-phone" style="color: white;"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1" style="color: #2c3e50;">Phone</h6>
                                            <p class="mb-0 text-muted">
                                                <a href="tel:+97141234567" style="color: inherit; text-decoration: none;">+971 4 123 4567</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="contact-item mb-4">
                                    <div class="d-flex align-items-center">
                                        <div style="width: 50px; height: 50px; background: #e74c3c; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                            <i class="fas fa-envelope" style="color: white;"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1" style="color: #2c3e50;">Email</h6>
                                            <p class="mb-0 text-muted">
                                                <a href="mailto:info@techdream.ae" style="color: inherit; text-decoration: none;">info@techdream.ae</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="contact-item">
                                    <div class="d-flex align-items-center">
                                        <div style="width: 50px; height: 50px; background: #f39c12; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                                            <i class="fas fa-clock" style="color: white;"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1" style="color: #2c3e50;">Business Hours</h6>
                                            <p class="mb-0 text-muted">
                                                Mon-Sat: 9 AM - 9 PM<br/>
                                                Sunday: 10 AM - 8 PM
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Support -->
                            <div style="background: white; border-radius: 15px; padding: 30px; box-shadow: 0 8px 25px rgba(0,0,0,0.1); margin-bottom: 30px;">
                                <h4 class="mb-4" style="color: #2c3e50;">Quick Support</h4>

                                <div class="quick-support-option mb-3">
                                    <a href="https://wa.me/971123456789" target="_blank" class="btn btn-success w-100 d-flex align-items-center justify-content-center">
                                        <i class="fab fa-whatsapp me-2"></i>
                                        WhatsApp Support
                                    </a>
                                </div>

                                <div class="quick-support-option mb-3">
                                    <a href="tel:+97141234567" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-phone me-2"></i>
                                        Call Us Now
                                    </a>
                                </div>

                                <div class="quick-support-option">
                                    <button class="btn btn-outline-primary w-100" onclick="startLiveChat()">
                                        <i class="fas fa-comments me-2"></i>
                                        Live Chat
                                    </button>
                                </div>
                            </div>

                            <!-- Social Media -->
                            <div style="background: white; border-radius: 15px; padding: 30px; box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                                <h4 class="mb-4" style="color: #2c3e50;">Follow Us</h4>
                                <div class="social-media d-flex gap-3">
                                    <a href="https://facebook.com/techdream" target="_blank" style="width: 50px; height: 50px; background: #3b5998; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none;" rel="noopener">
                                        <i class="fab fa-facebook-f"></i>
                                    </a>
                                    <a href="https://instagram.com/techdream" target="_blank" style="width: 50px; height: 50px; background: #E4405F; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none;" rel="noopener">
                                        <i class="fab fa-instagram"></i>
                                    </a>
                                    <a href="https://twitter.com/techdream" target="_blank" style="width: 50px; height: 50px; background: #1DA1F2; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none;" rel="noopener">
                                        <i class="fab fa-twitter"></i>
                                    </a>
                                    <a href="https://linkedin.com/company/techdream" target="_blank" style="width: 50px; height: 50px; background: #0077B5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none;" rel="noopener">
                                        <i class="fab fa-linkedin-in"></i>
                                    </a>
                                    <a href="https://youtube.com/techdream" target="_blank" style="width: 50px; height: 50px; background: #FF0000; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none;" rel="noopener">
                                        <i class="fab fa-youtube"></i>
                                    </a>
                                </div>

                                <div class="mt-4">
                                    <h6>Join our community</h6>
                                    <p class="text-muted small">Get the latest tech news, product updates, and exclusive offers.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Section -->
                    <div class="row mt-5">
                        <div class="col-12">
                            <h3 class="text-center mb-5" style="color: #2c3e50;">Frequently Asked Questions</h3>

                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="accordion" id="faqAccordion1">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="faq1">
                                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">
                                                    What is your return policy?
                                                </button>
                                            </h2>
                                            <div id="collapse1" class="accordion-collapse collapse show" aria-labelledby="faq1" data-bs-parent="#faqAccordion1">
                                                <div class="accordion-body">
                                                    We offer a 14-day return policy for unopened items in original packaging. Items must be returned in new condition with all accessories and documentation.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="faq2">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">
                                                    Do you offer warranty on products?
                                                </button>
                                            </h2>
                                            <div id="collapse2" class="accordion-collapse collapse" aria-labelledby="faq2" data-bs-parent="#faqAccordion1">
                                                <div class="accordion-body">
                                                    Yes, all our products come with manufacturer warranty. Most smartphones have 1-2 year international warranty, and accessories typically have 6-12 months warranty.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="faq3">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
                                                    What payment methods do you accept?
                                                </button>
                                            </h2>
                                            <div id="collapse3" class="accordion-collapse collapse" aria-labelledby="faq3" data-bs-parent="#faqAccordion1">
                                                <div class="accordion-body">
                                                    We accept Visa, Mastercard, PayPal, and Cash on Delivery. All online payments are processed securely through encrypted payment gateways.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="accordion" id="faqAccordion2">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="faq4">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
                                                    How long does delivery take?
                                                </button>
                                            </h2>
                                            <div id="collapse4" class="accordion-collapse collapse" aria-labelledby="faq4" data-bs-parent="#faqAccordion2">
                                                <div class="accordion-body">
                                                    Standard delivery takes 3-5 business days within UAE. Express delivery (1-2 days) and same-day delivery are available in Dubai and Abu Dhabi for an additional fee.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="faq5">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse5" aria-expanded="false" aria-controls="collapse5">
                                                    Do you have a physical store?
                                                </button>
                                            </h2>
                                            <div id="collapse5" class="accordion-collapse collapse" aria-labelledby="faq5" data-bs-parent="#faqAccordion2">
                                                <div class="accordion-body">
                                                    Yes, we have showrooms in Dubai and Abu Dhabi. You can visit us to see products in person, get technical support, or collect your online orders.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="faq6">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse6" aria-expanded="false" aria-controls="collapse6">
                                                    Do you offer bulk discounts?
                                                </button>
                                            </h2>
                                            <div id="collapse6" class="accordion-collapse collapse" aria-labelledby="faq6" data-bs-parent="#faqAccordion2">
                                                <div class="accordion-body">
                                                    Yes, we offer special pricing for bulk orders, corporate purchases, and educational institutions. Contact us with your requirements for a custom quote.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Map Section -->
                    <div class="row mt-5">
                        <div class="col-12">
                            <h3 class="text-center mb-4" style="color: #2c3e50;">Visit Our Store</h3>
                            <div style="background: white; border-radius: 15px; padding: 30px; box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                                <div class="row">
                                    <div class="col-lg-8">
                                        <!-- Google Maps Placeholder -->
                                        <div style="width: 100%; height: 400px; background: #f8f9fa; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                            <div class="text-center">
                                                <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #bdc3c7; margin-bottom: 1rem;"></i>
                                                <p class="text-muted">Interactive map will be embedded here</p>
                                                <small>Sheikh Zayed Road, Dubai, UAE</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <h5>Store Locations</h5>

                                        <div class="store-location mb-4">
                                            <h6 class="text-primary">Dubai Mall Store</h6>
                                            <p class="mb-1">Level 2, Dubai Mall</p>
                                            <p class="mb-1">Downtown Dubai, UAE</p>
                                            <p class="mb-1">
                                                <i class="fas fa-phone"></i> +971 4 123 4567
                                            </p>
                                            <p class="text-muted">Open: 10 AM - 12 AM</p>
                                        </div>

                                        <div class="store-location mb-4">
                                            <h6 class="text-primary">Marina Walk Store</h6>
                                            <p class="mb-1">Shop 15, Marina Walk</p>
                                            <p class="mb-1">Dubai Marina, UAE</p>
                                            <p class="mb-1">
                                                <i class="fas fa-phone"></i> +971 4 234 5678
                                            </p>
                                            <p class="text-muted">Open: 9 AM - 11 PM</p>
                                        </div>

                                        <div class="mt-4">
                                            <a href="/stores" class="btn btn-outline-primary">
                                                <i class="fas fa-store"></i> Find All Stores
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Form validation
                    const form = document.getElementById('contact-form');
                    const submitBtn = form.querySelector('button[type="submit"]');
                    
                    if (form &amp;&amp; submitBtn) {
                        form.addEventListener('submit', function(e) {
                            // Show loading state
                            submitBtn.innerHTML = '&lt;i class="fas fa-spinner fa-spin me-2"&gt;&lt;/i&gt;Sending...';
                            submitBtn.disabled = true;
                        });
                    }
                    
                    // Phone number formatting
                    const phoneInput = form.querySelector('input[name="phone"]');
                    if (phoneInput) {
                        phoneInput.addEventListener('input', function() {
                            let value = this.value.replace(/\D/g, '');
                            if (value.startsWith('971')) {
                                value = '+' + value;
                            } else if (value.startsWith('0')) {
                                value = '+971' + value.substring(1);
                            }
                            this.value = value;
                        });
                    }
                });
                
                function startLiveChat() {
                    alert('Live chat will be available soon! Please use WhatsApp or call us for immediate support.');
                }
            </script>
        </t>
    </template>

    <!-- Store Locator Page -->
