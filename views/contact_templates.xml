        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5">
                    <h1 class="text-center mb-5" style="color: #2c3e50;">Our Store Locations</h1>

                    <div class="row">
                        <div class="col-lg-4 mb-4">
                            <div class="store-card" style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                                <h4 class="text-primary">Dubai Mall Store</h4>
                                <p>
                                    <i class="fas fa-map-marker-alt text-danger"></i> Level 2, Dubai Mall, Downtown Dubai
                                </p>
                                <p>
                                    <i class="fas fa-phone text-success"></i> +971 4 123 4567
                                </p>
                                <p>
                                    <i class="fas fa-clock text-warning"></i> 10 AM - 12 AM (Daily)
                                </p>
                                <div class="mt-3">
                                    <span class="badge bg-success">Largest Store</span>
                                    <span class="badge bg-info">Service Center</span>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-outline-primary btn-sm">Get Directions</button>
                                    <button class="btn btn-outline-secondary btn-sm">Call Store</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 mb-4">
                            <div class="store-card" style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                                <h4 class="text-primary">Marina Walk Store</h4>
                                <p>
                                    <i class="fas fa-map-marker-alt text-danger"></i> Shop 15, Marina Walk, Dubai Marina
                                </p>
                                <p>
                                    <i class="fas fa-phone text-success"></i> +971 4 234 5678
                                </p>
                                <p>
                                    <i class="fas fa-clock text-warning"></i> 9 AM - 11 PM (Daily)
                                </p>
                                <div class="mt-3">
                                    <span class="badge bg-primary">Waterfront</span>
                                    <span class="badge bg-info">Accessories Hub</span>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-outline-primary btn-sm">Get Directions</button>
                                    <button class="btn btn-outline-secondary btn-sm">Call Store</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 mb-4">
                            <div class="store-card" style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 8px 25px rgba(0,0,0,0.1);">
                                <h4 class="text-primary">Abu Dhabi Store</h4>
                                <p>
                                    <i class="fas fa-map-marker-alt text-danger"></i> Yas Mall, Yas Island, Abu Dhabi
                                </p>
                                <p>
                                    <i class="fas fa-phone text-success"></i> +971 2 345 6789
                                </p>
                                <p>
                                    <i class="fas fa-clock text-warning"></i> 10 AM - 10 PM (Daily)
                                </p>
                                <div class="mt-3">
                                    <span class="badge bg-warning">New Store</span>
                                    <span class="badge bg-info">Gaming Zone</span>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-outline-primary btn-sm">Get Directions</button>
                                    <button class="btn btn-outline-secondary btn-sm">Call Store</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    </data>
</odoo>