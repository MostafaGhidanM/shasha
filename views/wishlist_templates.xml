<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Customer Wishlist Page -->
        <template id="wishlist_template" name="My Wishlist">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Wishlist</t>
                </t>

                <div class="container mt-3">
                    <div class="row">
                        <div class="col-12">
                            <h1>My Wishlist</h1>

                            <t t-if="wishlist_items">
                                <div class="row">
                                    <t t-foreach="wishlist_items" t-as="item">
                                        <div class="col-md-4 col-lg-3 mb-4">
                                            <div class="card h-100 wishlist-item">
                                                <div class="position-relative">
                                                    <img t-att-src="'/web/image/product.product/%s/image_1024' % item.product_id.id"
                                                         class="card-img-top"
                                                         t-att-alt="item.product_id.name"
                                                         style="height: 200px; object-fit: cover;"/>
                                                    <button class="btn btn-sm btn-danger position-absolute wishlist-remove-btn"
                                                            style="top: 10px; right: 10px;"
                                                            t-att-data-product-id="item.product_id.id"
                                                            onclick="toggleWishlist(this)">
                                                        <i class="fa fa-heart"></i>
                                                    </button>
                                                    <t t-if="item.product_tmpl_id.stock_status == 'out_of_stock'">
                                                        <span class="badge bg-danger position-absolute" style="top: 10px; left: 10px;">
                                                            Out of Stock
                                                        </span>
                                                    </t>
                                                </div>
                                                <div class="card-body d-flex flex-column">
                                                    <h5 class="card-title" t-field="item.product_tmpl_id.name"></h5>
                                                    <div class="price-section mb-3">
                                                        <span class="h5 text-primary" t-field="item.product_tmpl_id.list_price"
                                                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"></span>
                                                        <t t-if="item.product_tmpl_id.compare_list_price > 0">
                                                            <del class="text-muted ms-2" t-field="item.product_tmpl_id.compare_list_price"
                                                                 t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"></del>
                                                        </t>
                                                    </div>
                                                    <p class="card-text flex-grow-1" t-field="item.product_tmpl_id.short_description"></p>
                                                    <div class="mt-auto">
                                                        <div class="btn-group w-100" role="group">
                                                            <t t-if="item.product_tmpl_id.stock_status != 'out_of_stock'">
                                                                <button class="btn btn-primary btn-sm"
                                                                        t-att-data-product-id="item.product_id.id"
                                                                        onclick="moveToCart(this)">
                                                                    <i class="fa fa-shopping-cart"></i> Add to Cart
                                                                </button>
                                                            </t>
                                                            <t t-else="">
                                                                <button class="btn btn-secondary btn-sm" disabled="disabled">
                                                                    <i class="fa fa-ban"></i> Out of Stock
                                                                </button>
                                                            </t>
                                                            <a t-att-href="'/shop/product/%s' % item.product_tmpl_id.id"
                                                               class="btn btn-outline-primary btn-sm">
                                                                <i class="fa fa-eye"></i> View
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted mt-2">Added on <t t-esc="item.date_added.strftime('%B %d, %Y')"></t></small>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                                <div class="text-center mt-4">
                                    <a href="/shop" class="btn btn-primary">
                                        <i class="fa fa-arrow-left"></i> Continue Shopping
                                    </a>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="text-center py-5">
                                    <i class="fa fa-heart-o fa-5x text-muted mb-4"></i>
                                    <h3>Your Wishlist is Empty</h3>
                                    <p class="text-muted">Save items you like to your wishlist. Review them anytime and easily move them to your cart.</p>
                                    <a href="/shop" class="btn btn-primary">
                                        <i class="fa fa-shopping-bag"></i> Start Shopping
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Wishlist Button Widget -->
        <template id="product_wishlist_button" name="Wishlist Button">
            <button class="btn btn-outline-danger btn-sm wishlist-btn"
                    t-att-data-product-id="product.product_variant_id.id"
                    t-att-class="'btn btn-outline-danger btn-sm wishlist-btn' + (' active' if in_wishlist else '')"
                    onclick="toggleWishlist(this)"
                    title="Add to Wishlist">
                <i t-att-class="'fa ' + ('fa-heart' if in_wishlist else 'fa-heart-o')"></i>
            </button>
        </template>

        <!-- Mini Wishlist Widget for Header -->
        <template id="header_wishlist_widget" name="Header Wishlist Widget">
            <div class="dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                    <i class="fa fa-heart-o"></i>
                    <span class="badge bg-danger wishlist-count" style="display: none;">0</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end wishlist-dropdown" style="width: 300px;">
                    <li><h6 class="dropdown-header">Wishlist Items</h6></li>
                    <li class="wishlist-items-container">
                        <div class="text-center text-muted p-3">
                            <i class="fa fa-heart-o fa-2x mb-2"></i>
                            <p>No items in wishlist</p>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider"/></li>
                    <li>
                        <a class="dropdown-item text-center" href="/my/wishlist">
                            View All Wishlist Items
                        </a>
                    </li>
                </ul>
            </div>
        </template>
    </data>
</odoo>