<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product Comparison Page -->
        <template id="compare_products_template" name="Product Comparison">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <div class="container mt-3">
                        <div class="row">
                            <div class="col-12">
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                                        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
                                        <li class="breadcrumb-item active">Compare Products</li>
                                    </ol>
                                </nav>

                                <h1 class="text-center mb-4">Compare Products</h1>

                                <div class="comparison-container">
                                    <div class="row">
                                        <t t-foreach="products" t-as="product">
                                            <div class="col-md-3 product-comparison-card">
                                                <div class="card h-100">
                                                    <div class="position-relative">
                                                        <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                                                             class="card-img-top"
                                                             t-att-alt="product.name"
                                                             style="height: 200px; object-fit: cover;"/>
                                                        <button class="btn btn-sm btn-danger position-absolute"
                                                                style="top: 10px; right: 10px;"
                                                                t-att-data-product-id="product.id"
                                                                onclick="removeFromComparison(this)">
                                                            <i class="fa fa-times"></i>
                                                        </button>
                                                    </div>
                                                    <div class="card-body">
                                                        <h5 class="card-title" t-field="product.name"></h5>
                                                        <div class="price-section mb-3">
                                                            <span class="h4 text-primary" t-field="product.list_price"
                                                                  t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"></span>
                                                            <t t-if="product.compare_list_price > 0">
                                                                <del class="text-muted ms-2" t-field="product.compare_list_price"
                                                                     t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"></del>
                                                            </t>
                                                        </div>
                                                        <p class="card-text" t-field="product.short_description"></p>
                                                        <a t-att-href="'/shop/product/%s' % product.id" class="btn btn-primary btn-sm">View Details</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <t t-if="attributes">
                                        <div class="comparison-table mt-4">
                                            <h3>Detailed Comparison</h3>
                                            <div class="table-responsive">
                                                <table class="table table-bordered">
                                                    <thead class="table-dark">
                                                        <tr>
                                                            <th>Attribute</th>
                                                            <t t-foreach="products" t-as="product">
                                                                <th t-field="product.name"></th>
                                                            </t>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="attributes.values()" t-as="attr">
                                                            <tr>
                                                                <td><strong t-esc="attr['name']"></strong></td>
                                                                <t t-foreach="products" t-as="product">
                                                                    <td t-esc="attr['values'].get(product.id, '-')"></td>
                                                                </t>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </t>

                                    <div class="text-center mt-4">
                                        <button class="btn btn-outline-secondary" onclick="clearComparison()">
                                            <i class="fa fa-trash"></i> Clear All
                                        </button>
                                        <a href="/shop" class="btn btn-primary ms-2">
                                            <i class="fa fa-arrow-left"></i> Continue Shopping
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Empty Comparison Page -->
        <template id="compare_empty_template" name="Empty Comparison">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <div class="container mt-5">
                        <div class="row justify-content-center">
                            <div class="col-md-6 text-center">
                                <i class="fa fa-balance-scale fa-5x text-muted mb-4"></i>
                                <h2>No Products to Compare</h2>
                                <p class="text-muted">You haven't added any products to compare yet. Browse our products and add them to comparison.</p>
                                <a href="/shop" class="btn btn-primary">
                                    <i class="fa fa-shopping-bag"></i> Browse Products
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Comparison Widget for Product Cards -->
        <template id="product_comparison_button" name="Product Comparison Button">
            <button class="btn btn-outline-secondary btn-sm compare-btn"
                    t-att-data-product-id="product.id"
                    onclick="addToComparison(this)"
                    title="Add to Compare">
                <i class="fa fa-balance-scale"></i>
            </button>
        </template>
    </data>
</odoo>