<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Card Template -->
    <template id="product_card" name="Product Card">
        <div class="product-card h-100">
            <div class="card border-0 shadow-sm h-100 product-hover">
                <div class="card-img-top position-relative overflow-hidden" style="height: 250px;">
                    <a t-attf-href="#{product.website_url}">
                        <img t-if="product.image_1920"
                             t-att-src="'data:image/jpeg;base64,' + product.image_1920.decode('ascii')"
                             t-att-alt="product.name"
                             class="w-100 h-100 object-cover product-image"/>
                        <div t-if="not product.image_1920"
                             class="w-100 h-100 bg-secondary d-flex align-items-center justify-content-center">
                            <i class="fa fa-image fa-3x text-light"></i>
                        </div>
                    </a>

                    <!-- Product Badge -->
                    <div t-if="product.badge_text"
                         t-attf-class="position-absolute top-0 start-0 badge bg-#{product.badge_color or 'primary'} m-2">
                        <t t-esc="product.badge_text"/>
                    </div>

                    <!-- Action Buttons -->
                    <div class="position-absolute top-0 end-0 p-2">
                        <div class="btn-group-vertical">
                            <button class="btn btn-sm btn-light rounded-circle mb-1 product-action-btn"
                                    title="Add to Wishlist"
                                    t-att-data-product-id="product.id"
                                    onclick="toggleWishlist(this)">
                                <i class="fa fa-heart"></i>
                            </button>
                            <button class="btn btn-sm btn-light rounded-circle mb-1 product-action-btn"
                                    title="Quick View"
                                    t-att-data-product-id="product.id"
                                    onclick="quickView(this)">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-light rounded-circle product-action-btn"
                                    title="Add to Compare"
                                    t-att-data-product-id="product.id"
                                    onclick="addToCompare(this)">
                                <i class="fa fa-balance-scale"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Quick Add to Cart Button -->
                    <div class="position-absolute bottom-0 start-50 translate-middle-x pb-2 quick-cart-btn" style="opacity: 0; transition: opacity 0.3s;">
                        <button class="btn btn-primary btn-sm"
                                t-att-data-product-id="product.id"
                                onclick="quickAddToCart(this)">
                            <i class="fa fa-shopping-cart me-1"></i> Quick Add
                        </button>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Brand -->
                    <div t-if="product.brand_id" class="product-brand mb-2">
                        <small class="text-muted">
                            <a t-attf-href="/brand/#{product.brand_id.id}" class="text-decoration-none">
                                <t t-esc="product.brand_id.name"/>
                            </a>
                        </small>
                    </div>

                    <!-- Product Name -->
                    <h6 class="card-title mb-2">
                        <a t-attf-href="#{product.website_url}" class="text-decoration-none text-dark">
                            <t t-esc="product.name"/>
                        </a>
                    </h6>

                    <!-- Rating -->
                    <div t-if="product.rating_avg" class="product-rating mb-2">
                        <t t-set="rating" t-value="int(product.rating_avg or 0)"/>
                        <t t-foreach="range(5)" t-as="star">
                            <i t-if="star &lt; rating" class="fa fa-star text-warning"></i>
                            <i t-else="" class="fa fa-star-o text-muted"></i>
                        </t>
                        <small class="text-muted ms-1">(<t t-esc="product.rating_count or 0"/>)</small>
                    </div>

                    <!-- Price -->
                    <div class="product-price">
                        <span class="fw-bold text-primary">
                            <t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </span>
                    </div>

                    <!-- Description -->
                    <p t-if="product.description_sale" class="card-text text-muted small mt-2">
                        <t t-esc="product.description_sale[:100]"/>
                        <span t-if="len(product.description_sale) > 100">...</span>
                    </p>
                </div>

                <div class="card-footer bg-transparent border-0 pt-0">
                    <button class="btn btn-primary w-100 add-to-cart-btn"
                            t-att-data-product-id="product.id"
                            onclick="addToCart(this)">
                        <i class="fa fa-shopping-cart me-1"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </template>

    <!-- Quick View Modal Template -->
    <template id="quick_view_modal" name="Quick View Modal">
        <div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="quickViewModalLabel">Product Quick View</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" id="quickViewContent">
                        <!-- Content will be loaded dynamically -->
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Product List View -->
    <template id="product_list_item" name="Product List Item">
        <div class="product-list-item">
            <div class="card border-0 shadow-sm mb-3">
                <div class="row g-0">
                    <div class="col-md-3">
                        <div class="position-relative" style="height: 200px;">
                            <a t-attf-href="#{product.website_url}">
                                <img t-if="product.image_1920"
                                     t-att-src="'data:image/jpeg;base64,' + product.image_1920.decode('ascii')"
                                     t-att-alt="product.name"
                                     class="w-100 h-100 object-cover"/>
                                <div t-if="not product.image_1920"
                                     class="w-100 h-100 bg-secondary d-flex align-items-center justify-content-center">
                                    <i class="fa fa-image fa-2x text-light"></i>
                                </div>
                            </a>
                            <div t-if="product.badge_text"
                                 t-attf-class="position-absolute top-0 start-0 badge bg-#{product.badge_color or 'primary'} m-2">
                                <t t-esc="product.badge_text"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card-body">
                            <div t-if="product.brand_id" class="product-brand mb-2">
                                <small class="text-muted">
                                    <a t-attf-href="/brand/#{product.brand_id.id}" class="text-decoration-none">
                                        <t t-esc="product.brand_id.name"/>
                                    </a>
                                </small>
                            </div>
                            <h5 class="card-title mb-2">
                                <a t-attf-href="#{product.website_url}" class="text-decoration-none text-dark">
                                    <t t-esc="product.name"/>
                                </a>
                            </h5>
                            <div t-if="product.rating_avg" class="product-rating mb-2">
                                <t t-set="rating" t-value="int(product.rating_avg or 0)"/>
                                <t t-foreach="range(5)" t-as="star">
                                    <i t-if="star &lt; rating" class="fa fa-star text-warning"></i>
                                    <i t-else="" class="fa fa-star-o text-muted"></i>
                                </t>
                                <small class="text-muted ms-1">(<t t-esc="product.rating_count or 0"/>)</small>
                            </div>
                            <p t-if="product.description_sale" class="card-text text-muted">
                                <t t-esc="product.description_sale[:200]"/>
                                <span t-if="len(product.description_sale) > 200">...</span>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-body d-flex flex-column justify-content-between h-100">
                            <div class="product-price text-center">
                                <div class="fw-bold text-primary h5">
                                    <t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                </div>
                            </div>
                            <div class="product-actions">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-primary"
                                            t-att-data-product-id="product.id"
                                            onclick="addToCart(this)">
                                        <i class="fa fa-shopping-cart me-1"></i> Add to Cart
                                    </button>
                                    <div class="btn-group">
                                        <button class="btn btn-outline-secondary btn-sm"
                                                title="Add to Wishlist"
                                                t-att-data-product-id="product.id"
                                                onclick="toggleWishlist(this)">
                                            <i class="fa fa-heart"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                title="Add to Compare"
                                                t-att-data-product-id="product.id"
                                                onclick="addToCompare(this)">
                                            <i class="fa fa-balance-scale"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>