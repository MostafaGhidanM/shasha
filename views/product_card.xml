<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Professional Bootstrap Card Enhancement -->
        <template id="products_item_enhanced" inherit_id="website_sale.products_item">
            <!-- Add professional card styling -->
            <xpath expr="." position="inside">
                <style>
                    /* Force full width container */
                    .container, .container-fluid {
                        max-width: 100% !important;
                        width: 100% !important;
                        padding-left: 15px !important;
                        padding-right: 15px !important;
                    }

                    /* Fix shop container width */
                    #wrap .container {
                        max-width: 1200px !important;
                        margin: 0 auto !important;
                    }

                    /* Professional 4-Column Grid System */
                    #products_grid,
                    .oe_website_sale #products_grid {
                        width: 100% !important;
                    }

                    #products_grid .row,
                    .oe_website_sale .row {
                        display: flex !important;
                        flex-wrap: wrap !important;
                        margin: 0 -15px !important;
                        width: 100% !important;
                    }

                    /* Force 4-column layout */
                    .oe_website_sale .col-lg-3 {
                        flex: 0 0 25% !important;
                        max-width: 25% !important;
                        padding: 0 15px !important;
                        margin-bottom: 30px !important;
                    }

                    @media (max-width: 1199px) {
                        .oe_website_sale .col-lg-3 {
                            flex: 0 0 33.333333% !important;
                            max-width: 33.333333% !important;
                        }
                    }

                    @media (max-width: 991px) {
                        .oe_website_sale .col-lg-3 {
                            flex: 0 0 50% !important;
                            max-width: 50% !important;
                        }
                    }

                    @media (max-width: 767px) {
                        .oe_website_sale .col-lg-3 {
                            flex: 0 0 100% !important;
                            max-width: 100% !important;
                        }
                    }

                    /* Reset any conflicting styles */
                    .oe_website_sale .col-lg-3.col-md-4.col-sm-6 {
                        flex: 0 0 25% !important;
                        max-width: 25% !important;
                    }

                    /* Professional Product Card Design */
                    .oe_product {
                        background: #ffffff !important;
                        border: 1px solid #e5e7eb !important;
                        border-radius: 16px !important;
                        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06) !important;
                        transition: all 0.3s ease !important;
                        margin-bottom: 0 !important;
                        padding: 0 !important;
                        overflow: hidden !important;
                        height: 420px !important;
                        display: flex !important;
                        flex-direction: column !important;
                        position: relative !important;
                        width: 100% !important;
                    }

                    .oe_product:hover {
                        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
                        transform: translateY(-8px) !important;
                        border-color: #3b82f6 !important;
                    }

                    /* Product Image Container */
                    .oe_product_image {
                        position: relative !important;
                        overflow: hidden !important;
                        border-radius: 16px 16px 0 0 !important;
                        height: 220px !important;
                        background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%) !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                    }

                    .oe_product_image img {
                        width: 100% !important;
                        height: 100% !important;
                        object-fit: contain !important;
                        transition: transform 0.3s ease !important;
                        padding: 15px !important;
                    }

                    .oe_product:hover .oe_product_image img {
                        transform: scale(1.05) !important;
                    }

                    /* Card Body */
                    .product-card-body {
                        padding: 20px !important;
                        flex-grow: 1 !important;
                        display: flex !important;
                        flex-direction: column !important;
                        background: #ffffff !important;
                        height: 200px !important;
                    }

                    /* Product Title */
                    .product-title {
                        font-size: 16px !important;
                        font-weight: 600 !important;
                        color: #111827 !important;
                        margin-bottom: 10px !important;
                        line-height: 1.4 !important;
                        text-decoration: none !important;
                        display: -webkit-box !important;
                        -webkit-line-clamp: 2 !important;
                        -webkit-box-orient: vertical !important;
                        overflow: hidden !important;
                        min-height: 44px !important;
                    }

                    .product-title:hover {
                        color: #3b82f6 !important;
                        text-decoration: none !important;
                    }

                    /* Price Styling */
                    .product-price {
                        font-size: 20px !important;
                        font-weight: 700 !important;
                        color: #059669 !important;
                        margin-bottom: 15px !important;
                        display: flex !important;
                        align-items: center !important;
                        gap: 8px !important;
                    }

                    .product-price .text-muted {
                        font-size: 16px !important;
                        font-weight: 500 !important;
                        color: #9ca3af !important;
                    }

                    /* Badge Styling */
                    .stock-badge {
                        position: absolute !important;
                        top: 0.75rem !important;
                        right: 0.75rem !important;
                        z-index: 10 !important;
                        font-size: 0.75rem !important;
                        font-weight: 600 !important;
                        padding: 0.375rem 0.75rem !important;
                        border-radius: 20px !important;
                        backdrop-filter: blur(10px) !important;
                    }

                    .badge.bg-success {
                        background: linear-gradient(135deg, #10b981, #059669) !important;
                        color: white !important;
                    }

                    .badge.bg-warning {
                        background: linear-gradient(135deg, #f59e0b, #d97706) !important;
                        color: white !important;
                    }

                    .badge.bg-danger {
                        background: linear-gradient(135deg, #ef4444, #dc2626) !important;
                        color: white !important;
                    }

                    .discount-badge {
                        position: absolute !important;
                        top: 0.75rem !important;
                        left: 0.75rem !important;
                        z-index: 10 !important;
                        background: linear-gradient(135deg, #ef4444, #dc2626) !important;
                        color: white !important;
                        font-size: 0.8rem !important;
                        font-weight: 700 !important;
                        padding: 0.375rem 0.75rem !important;
                        border-radius: 20px !important;
                        backdrop-filter: blur(10px) !important;
                    }

                    /* Action Buttons */
                    .product-actions {
                        margin-top: auto !important;
                        padding: 0 !important;
                    }

                    .btn-add-to-cart {
                        width: 100% !important;
                        border-radius: 8px !important;
                        font-weight: 600 !important;
                        padding: 12px 16px !important;
                        margin-bottom: 10px !important;
                        font-size: 14px !important;
                        background: linear-gradient(135deg, #3b82f6, #1d4ed8) !important;
                        border: none !important;
                        color: white !important;
                        transition: all 0.3s ease !important;
                        text-transform: uppercase !important;
                        letter-spacing: 0.5px !important;
                    }

                    .btn-add-to-cart:hover {
                        background: linear-gradient(135deg, #1d4ed8, #1e40af) !important;
                        transform: translateY(-2px) !important;
                        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4) !important;
                    }

                    .btn-add-to-cart:disabled {
                        background: #9ca3af !important;
                        cursor: not-allowed !important;
                        transform: none !important;
                        box-shadow: none !important;
                    }

                    .btn-product-actions {
                        display: flex !important;
                        gap: 0.5rem !important;
                    }

                    .btn-product-actions .btn {
                        flex: 1 !important;
                        font-size: 0.8rem !important;
                        padding: 0.5rem 0.75rem !important;
                        border-radius: 6px !important;
                        font-weight: 500 !important;
                        transition: all 0.3s ease !important;
                    }

                    .btn-outline-primary {
                        border-color: #e5e7eb !important;
                        color: #6b7280 !important;
                        background: #ffffff !important;
                    }

                    .btn-outline-primary:hover {
                        background: #4f46e5 !important;
                        border-color: #4f46e5 !important;
                        color: white !important;
                        transform: translateY(-1px) !important;
                    }

                    .btn-outline-danger {
                        border-color: #e5e7eb !important;
                        color: #6b7280 !important;
                        background: #ffffff !important;
                    }

                    .btn-outline-danger:hover {
                        background: #ef4444 !important;
                        border-color: #ef4444 !important;
                        color: white !important;
                        transform: translateY(-1px) !important;
                    }

                    /* Product Rating Stars (if needed) */
                    .product-rating {
                        display: flex !important;
                        align-items: center !important;
                        gap: 0.25rem !important;
                        margin-bottom: 0.5rem !important;
                        color: #fbbf24 !important;
                        font-size: 0.875rem !important;
                    }

                    /* Responsive Adjustments */
                    @media (max-width: 576px) {
                        .oe_website_sale .products_row {
                            grid-template-columns: 1fr !important;
                            gap: 1rem !important;
                        }

                        .product-card-body {
                            padding: 1rem !important;
                        }

                        .oe_product_image {
                            height: 180px !important;
                        }
                    }

                    /* Loading Animation */
                    .oe_product_image::before {
                        content: '' !important;
                        position: absolute !important;
                        top: 0 !important;
                        left: -100% !important;
                        width: 100% !important;
                        height: 100% !important;
                        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent) !important;
                        transition: left 0.5s !important;
                    }

                    .oe_product:hover .oe_product_image::before {
                        left: 100% !important;
                    }
                </style>

                <!-- Professional card body structure -->
                <div class="product-card-body">
                    <!-- Stock status badge -->
                    <t t-set="total_qty" t-value="sum(product.product_variant_ids.mapped('qty_available'))"/>
                    <t t-if="total_qty == 0">
                        <span class="badge bg-danger stock-badge">Out of Stock</span>
                    </t>
                    <t t-elif="total_qty &lt;= 10">
                        <span class="badge bg-warning text-dark stock-badge">Low Stock</span>
                    </t>
                    <t t-else="">
                        <span class="badge bg-success stock-badge">In Stock</span>
                    </t>

                    <!-- Discount badge -->
                    <t t-if="product.compare_list_price and product.compare_list_price &gt; product.list_price">
                        <t t-set="discount" t-value="int(((product.compare_list_price - product.list_price) / product.compare_list_price) * 100)"/>
                        <span class="discount-badge">-<t t-esc="discount"/>%</span>
                    </t>

                    <!-- Product title as clickable link -->
                    <h5 class="card-title mb-2">
                        <a t-attf-href="/shop/product/#{slug(product)}" class="product-title">
                            <span t-field="product.name"/>
                        </a>
                    </h5>

                    <!-- Product price -->
                    <div class="product-price mb-3">
                        <span t-field="product.list_price"
                              t-options='{"widget": "monetary", "display_currency": website.currency_id}'/>
                        <t t-if="product.compare_list_price and product.compare_list_price &gt; product.list_price">
                            <small class="text-muted ms-2">
                                <del t-field="product.compare_list_price"
                                     t-options='{"widget": "monetary", "display_currency": website.currency_id}'/>
                            </small>
                        </t>
                    </div>

                    <!-- Action buttons -->
                    <div class="product-actions">
                        <!-- Add to Cart Button -->
                        <t t-if="total_qty &gt; 0">
                            <form action="/shop/cart/update" method="post" class="d-inline-block w-100">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>
                                <input type="hidden" name="add_qty" value="1"/>
                                <button type="submit" class="btn btn-primary btn-add-to-cart">
                                    <i class="fa fa-shopping-cart me-1"></i> Add to Cart
                                </button>
                            </form>
                        </t>
                        <t t-else="">
                            <button class="btn btn-secondary btn-add-to-cart" disabled="disabled">
                                <i class="fa fa-ban me-1"></i> Out of Stock
                            </button>
                        </t>

                        <!-- Quick actions -->
                        <div class="d-flex btn-product-actions">
                            <a t-attf-href="/shop/product/#{slug(product)}"
                               class="btn btn-outline-primary btn-sm">
                                <i class="fa fa-eye me-1"></i> View
                            </a>
                            <button class="btn btn-outline-danger btn-sm"
                                    onclick="addToWishlist(#{product.id})"
                                    title="Add to Wishlist">
                                <i class="fa fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- JavaScript for wishlist -->
                <script>
                    function addToWishlist(productId) {
                        // Simple wishlist functionality
                        console.log('Added product ' + productId + ' to wishlist');
                        // You can enhance this with AJAX calls later
                    }
                </script>
            </xpath>
        </template>
    </data>
</odoo>