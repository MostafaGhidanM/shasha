<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Enhance Odoo's default product item template -->
        <template id="products_item_enhanced" inherit_id="website_sale.products_item">
            <!-- Ensure product card is clickable by maintaining original link structure -->
            <xpath expr="//div[hasclass('oe_product_image')]" position="attributes">
                <attribute name="style">position: relative;</attribute>
            </xpath>

            <!-- Add stock status badge -->
            <xpath expr="//div[hasclass('product_price')]" position="before">
                <div class="stock-status mb-2">
                    <t t-set="total_qty" t-value="sum(product.product_variant_ids.mapped('qty_available'))"/>
                    <t t-if="total_qty == 0">
                        <span class="badge bg-danger">Out of Stock</span>
                    </t>
                    <t t-elif="total_qty &lt;= 10">
                        <span class="badge bg-warning text-dark">Low Stock</span>
                    </t>
                    <t t-else="">
                        <span class="badge bg-success">In Stock</span>
                    </t>
                </div>
            </xpath>

            <!-- Enhance add to cart button without breaking original functionality -->
            <xpath expr="//form[hasclass('js_add_cart_variants')]" position="inside">
                <t t-set="total_qty" t-value="sum(product.product_variant_ids.mapped('qty_available'))"/>
                <t t-if="total_qty == 0">
                    <script>
                        // Disable add to cart for out of stock products
                        $(document).ready(function() {
                            $('form.js_add_cart_variants input[name="add_qty"]').closest('form').find('button[type="submit"]').prop('disabled', true).text('Out of Stock');
                        });
                    </script>
                </t>
            </xpath>

            <!-- Add discount percentage badge -->
            <xpath expr="//div[hasclass('oe_product_image')]" position="inside">
                <t t-if="product.compare_list_price and product.compare_list_price &gt; product.list_price">
                    <div class="discount-badge">
                        <t t-set="discount" t-value="int(((product.compare_list_price - product.list_price) / product.compare_list_price) * 100)"/>
                        <span class="badge bg-danger position-absolute" style="top: 10px; right: 10px; z-index: 10;">
                            -<t t-esc="discount"/>%
                        </span>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- Add category product count -->
        <template id="category_count_enhanced" inherit_id="website_sale.categories_recursive">
            <xpath expr="//a[@t-att-href]" position="inside">
                <span class="badge bg-secondary ms-2" t-esc="category.product_count or 0"/>
            </xpath>
        </template>

    </data>
</odoo>