<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Very minimal enhancement - just add to the end of the template -->
        <template id="products_item_enhanced" inherit_id="website_sale.products_item">
            <!-- Add stock status at the end of product item -->
            <xpath expr="." position="inside">
                <div class="stock-status-badge text-center mt-1">
                    <t t-set="total_qty" t-value="sum(product.product_variant_ids.mapped('qty_available'))"/>
                    <t t-if="total_qty == 0">
                        <small><span class="badge bg-danger">Out of Stock</span></small>
                    </t>
                    <t t-elif="total_qty &lt;= 10">
                        <small><span class="badge bg-warning text-dark">Low Stock</span></small>
                    </t>
                    <t t-else="">
                        <small><span class="badge bg-success">In Stock</span></small>
                    </t>
                </div>
            </xpath>
        </template>
    </data>
</odoo>