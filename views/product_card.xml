<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product Card Template -->
        <template id="product_card" name="Product Card">
            <div class="col-lg-3 col-md-4 col-sm-6 col-12 mb-4">
                <div class="card product-card h-100 border-0 shadow-sm" t-att-data-product-id="product.id">
                    <div class="position-relative overflow-hidden">
                        <!-- Product Image -->
                        <a t-att-href="'/shop/product/%s' % slug(product)" class="text-decoration-none">
                            <img t-att-src="website.image_url(product, 'image_1024')"
                                 t-att-alt="product.name"
                                 class="card-img-top product-image"
                                 style="height: 250px; object-fit: cover; transition: transform 0.3s ease;"
                                 loading="lazy"/>
                        </a>

                        <!-- Product Labels -->
                        <div class="position-absolute" style="top: 10px; left: 10px; z-index: 2;">
                            <t t-if="product.product_label == 'new'">
                                <span class="badge bg-primary">New</span>
                            </t>
                            <t t-if="product.product_label == 'sale'">
                                <span class="badge bg-danger">Sale</span>
                            </t>
                            <t t-if="product.product_label == 'hot'">
                                <span class="badge bg-warning text-dark">Hot</span>
                            </t>
                            <t t-if="product.discount_percentage and product.discount_percentage &gt; 0">
                                <span class="badge bg-danger ms-1">-<t t-esc="int(product.discount_percentage)"/>%</span>
                            </t>
                        </div>

                        <!-- Quick Action Buttons -->
                        <div class="position-absolute product-actions" style="top: 10px; right: 10px; opacity: 0; transition: opacity 0.3s ease;">
                            <!-- Wishlist Button -->
                            <button class="btn btn-light btn-sm rounded-circle mb-2 wishlist-btn"
                                    t-att-data-product-id="product.product_variant_id.id"
                                    onclick="toggleWishlist(this)"
                                    title="Add to Wishlist">
                                <i class="fa fa-heart-o"></i>
                            </button>

                            <!-- Quick View Button -->
                            <button class="btn btn-light btn-sm rounded-circle quick-view-btn"
                                    t-att-data-product-id="product.id"
                                    onclick="quickView(this)"
                                    title="Quick View">
                                <i class="fa fa-eye"></i>
                            </button>
                        </div>

                        <!-- Stock Status -->
                        <div class="position-absolute" style="bottom: 10px; left: 10px;">
                            <t t-set="total_qty" t-value="sum(product.product_variant_ids.mapped('qty_available'))"/>
                            <t t-if="total_qty == 0">
                                <span class="badge bg-danger">Out of Stock</span>
                            </t>
                            <t t-elif="total_qty &lt;= 10">
                                <span class="badge bg-warning text-dark">Low Stock</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-success">In Stock</span>
                            </t>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <!-- Product Brand -->
                        <div class="mb-1" t-if="product.brand_id">
                            <small class="text-muted" t-field="product.brand_id.name"/>
                        </div>

                        <!-- Product Name -->
                        <h5 class="card-title mb-2">
                            <a t-att-href="'/shop/product/%s' % slug(product)"
                               class="text-decoration-none text-dark product-name"
                               style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                <span t-field="product.name"/>
                            </a>
                        </h5>

                        <!-- Product Description -->
                        <p class="card-text text-muted small mb-3 flex-grow-1"
                           style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
                           t-if="product.short_description">
                            <span t-field="product.short_description"/>
                        </p>

                        <!-- Product Rating -->
                        <div class="mb-2" t-if="product.rating_avg and product.rating_avg &gt; 0">
                            <div class="d-flex align-items-center">
                                <div class="text-warning me-2">
                                    <t t-foreach="range(5)" t-as="star">
                                        <i t-att-class="'fa fa-star%s' % ('' if star &lt; product.rating_avg else '-o')"></i>
                                    </t>
                                </div>
                                <small class="text-muted">(<span t-field="product.rating_count"/>)</small>
                            </div>
                        </div>

                        <!-- Price Section -->
                        <div class="price-section mb-3">
                            <div class="d-flex align-items-center">
                                <span class="h5 text-primary mb-0 me-2"
                                      t-field="product.list_price"
                                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                <t t-if="product.compare_list_price and product.compare_list_price &gt; product.list_price">
                                    <del class="text-muted"
                                         t-field="product.compare_list_price"
                                         t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                </t>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-auto">
                            <t t-set="total_qty" t-value="sum(product.product_variant_ids.mapped('qty_available'))"/>
                            <t t-if="total_qty &gt; 0">
                                <!-- Add to Cart Button -->
                                <button class="btn btn-primary w-100 add-to-cart-btn"
                                        t-att-data-product-id="product.product_variant_id.id"
                                        onclick="addToCart(this)">
                                    <i class="fa fa-shopping-cart me-2"></i>Add to Cart
                                </button>
                            </t>
                            <t t-else="">
                                <!-- Out of Stock Button -->
                                <button class="btn btn-secondary w-100" disabled="disabled">
                                    <i class="fa fa-ban me-2"></i>Out of Stock
                                </button>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <!-- Product Grid Template -->
        <template id="product_grid" name="Product Grid">
            <div class="row product-grid">
                <t t-foreach="products" t-as="product">
                    <t t-call="shasha.product_card">
                        <t t-set="product" t-value="product"/>
                    </t>
                </t>
            </div>
        </template>

        <!-- Enhanced Shop Page Template -->
        <template id="shop_page_enhanced" name="Enhanced Shop Page" inherit_id="website_sale.products">
            <xpath expr="//div[@id='products_grid']" position="replace">
                <div id="products_grid" class="container-fluid">
                    <t t-call="shasha.product_grid">
                        <t t-set="products" t-value="products"/>
                    </t>
                </div>
            </xpath>
        </template>
    </data>
</odoo>