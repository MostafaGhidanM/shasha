<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Comparison Page -->
    <template id="compare_page" name="Product Comparison">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="mb-4">Product Comparison</h1>

                            <t t-if="not products">
                                <div class="text-center py-5">
                                    <i class="fa fa-balance-scale fa-4x text-muted mb-3"></i>
                                    <h4 class="text-muted">No products to compare</h4>
                                    <p class="text-muted">Add products to comparison from the shop page</p>
                                    <a href="/shop" class="btn btn-primary">Browse Products</a>
                                </div>
                            </t>

                            <t t-if="products">
                                <div class="comparison-table-wrapper">
                                    <div class="table-responsive">
                                        <table class="table table-bordered comparison-table">
                                            <thead>
                                                <tr>
                                                    <th class="comparison-feature-col">Features</th>
                                                    <t t-foreach="products" t-as="product">
                                                        <th class="comparison-product-col text-center">
                                                            <div class="product-comparison-header">
                                                                <button class="btn btn-sm btn-outline-danger float-end remove-from-comparison"
                                                                        t-att-data-product-id="product.id"
                                                                        title="Remove from comparison">
                                                                    <i class="fa fa-times"></i>
                                                                </button>
                                                                <div class="product-image mb-2">
                                                                    <img t-if="product.image_1920"
                                                                         t-att-src="'data:image/jpeg;base64,' + product.image_1920.decode('ascii')"
                                                                         t-att-alt="product.name"
                                                                         class="img-fluid"
                                                                         style="max-height: 150px;"/>
                                                                </div>
                                                                <h6 class="product-name">
                                                                    <a t-attf-href="#{product.website_url}" class="text-decoration-none">
                                                                        <t t-esc="product.name"/>
                                                                    </a>
                                                                </h6>
                                                            </div>
                                                        </th>
                                                    </t>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Price Row -->
                                                <tr>
                                                    <td class="fw-bold">Price</td>
                                                    <t t-foreach="products" t-as="product">
                                                        <td class="text-center">
                                                            <t t-set="combination_info" t-value="product._get_combination_info_variant()"/>
                                                            <div class="price-info">
                                                                <div t-if="combination_info['has_discounted_price']" class="text-muted text-decoration-line-through small">
                                                                    <t t-esc="combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                                </div>
                                                                <div class="fw-bold text-primary h6">
                                                                    <t t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </t>
                                                </tr>

                                                <!-- Brand Row -->
                                                <tr>
                                                    <td class="fw-bold">Brand</td>
                                                    <t t-foreach="products" t-as="product">
                                                        <td class="text-center">
                                                            <span t-if="product.brand_id" t-esc="product.brand_id.name"/>
                                                            <span t-if="not product.brand_id" class="text-muted">-</span>
                                                        </td>
                                                    </t>
                                                </tr>

                                                <!-- Rating Row -->
                                                <tr t-if="any(hasattr(p, 'rating_avg') and p.rating_avg for p in products)">
                                                    <td class="fw-bold">Rating</td>
                                                    <t t-foreach="products" t-as="product">
                                                        <td class="text-center">
                                                            <t t-if="hasattr(product, 'rating_avg') and product.rating_avg">
                                                                <t t-set="rating" t-value="int(product.rating_avg)"/>
                                                                <div class="rating-stars">
                                                                    <t t-foreach="range(5)" t-as="star">
                                                                        <i t-if="star &lt; rating" class="fa fa-star text-warning"></i>
                                                                        <i t-else="" class="fa fa-star-o text-muted"></i>
                                                                    </t>
                                                                </div>
                                                                <small class="text-muted d-block">(<t t-esc="product.rating_count or 0"/> reviews)</small>
                                                            </t>
                                                            <span t-if="not (hasattr(product, 'rating_avg') and product.rating_avg)" class="text-muted">Not rated</span>
                                                        </td>
                                                    </t>
                                                </tr>

                                                <!-- Description Row -->
                                                <tr>
                                                    <td class="fw-bold">Description</td>
                                                    <t t-foreach="products" t-as="product">
                                                        <td class="text-center">
                                                            <div class="product-description" style="max-height: 100px; overflow-y: auto;">
                                                                <t t-if="product.description_sale" t-esc="product.description_sale"/>
                                                                <span t-if="not product.description_sale" class="text-muted">No description available</span>
                                                            </div>
                                                        </td>
                                                    </t>
                                                </tr>

                                                <!-- Attributes Rows -->
                                                <t t-foreach="attributes" t-as="attr_info">
                                                    <tr>
                                                        <td class="fw-bold" t-esc="attr_info['attribute'].name"/>
                                                        <t t-foreach="products" t-as="product">
                                                            <td class="text-center">
                                                                <t t-set="values" t-value="attr_info['values'].get(product.id, [])"/>
                                                                <t t-if="values">
                                                                    <t t-foreach="values" t-as="value">
                                                                        <span class="badge bg-light text-dark me-1" t-esc="value"/>
                                                                    </t>
                                                                </t>
                                                                <span t-if="not values" class="text-muted">-</span>
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>

                                                <!-- Action Row -->
                                                <tr>
                                                    <td class="fw-bold">Actions</td>
                                                    <t t-foreach="products" t-as="product">
                                                        <td class="text-center">
                                                            <div class="d-grid gap-2">
                                                                <button class="btn btn-primary btn-sm add-to-cart-btn"
                                                                        t-att-data-product-id="product.id"
                                                                        onclick="addToCart(this)">
                                                                    <i class="fa fa-shopping-cart me-1"></i> Add to Cart
                                                                </button>
                                                                <button class="btn btn-outline-secondary btn-sm"
                                                                        t-att-data-product-id="product.id"
                                                                        onclick="toggleWishlist(this)"
                                                                        title="Add to Wishlist">
                                                                    <i class="fa fa-heart me-1"></i> Wishlist
                                                                </button>
                                                                <a t-attf-href="#{product.website_url}" class="btn btn-outline-info btn-sm">
                                                                    <i class="fa fa-eye me-1"></i> View Details
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="text-center mt-4">
                                    <button class="btn btn-outline-danger me-2" onclick="clearComparison()">
                                        <i class="fa fa-trash me-1"></i> Clear All
                                    </button>
                                    <a href="/shop" class="btn btn-primary">
                                        <i class="fa fa-plus me-1"></i> Add More Products
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- About Page Template -->
    <template id="about_page" name="About Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row">
                        <div class="col-12 text-center mb-5">
                            <h1 class="display-4 fw-bold">About Shasha Store</h1>
                            <p class="lead text-muted">Your trusted e-commerce destination</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-8 mx-auto">
                            <div class="about-content">
                                <p class="lead">Welcome to Shasha Store, where quality meets convenience. We are dedicated to providing you with the best shopping experience possible.</p>

                                <h3 class="mt-4 mb-3">Our Mission</h3>
                                <p>To deliver exceptional products and outstanding customer service that exceeds expectations every time.</p>

                                <h3 class="mt-4 mb-3">Why Choose Us?</h3>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="feature-item">
                                            <i class="fa fa-shield fa-2x text-primary mb-2"></i>
                                            <h5>Quality Assurance</h5>
                                            <p class="text-muted">All products undergo rigorous quality checks before reaching you.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="feature-item">
                                            <i class="fa fa-shipping-fast fa-2x text-primary mb-2"></i>
                                            <h5>Fast Delivery</h5>
                                            <p class="text-muted">Quick and reliable shipping to get your orders to you on time.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="feature-item">
                                            <i class="fa fa-headset fa-2x text-primary mb-2"></i>
                                            <h5>24/7 Support</h5>
                                            <p class="text-muted">Our customer support team is always ready to help you.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="feature-item">
                                            <i class="fa fa-undo fa-2x text-primary mb-2"></i>
                                            <h5>Easy Returns</h5>
                                            <p class="text-muted">Hassle-free return policy for your peace of mind.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Contact Page Template -->
    <template id="contact_page" name="Contact Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row">
                        <div class="col-12 text-center mb-5">
                            <h1 class="display-4 fw-bold">Contact Us</h1>
                            <p class="lead text-muted">We'd love to hear from you</p>
                        </div>
                    </div>
                    <div class="row g-5">
                        <div class="col-lg-8">
                            <div class="contact-form">
                                <h3 class="mb-4">Send us a message</h3>
                                <form class="row g-3">
                                    <div class="col-md-6">
                                        <label for="contactName" class="form-label">Name *</label>
                                        <input type="text" class="form-control" id="contactName" required=""/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="contactEmail" class="form-label">Email *</label>
                                        <input type="email" class="form-control" id="contactEmail" required=""/>
                                    </div>
                                    <div class="col-12">
                                        <label for="contactSubject" class="form-label">Subject</label>
                                        <input type="text" class="form-control" id="contactSubject"/>
                                    </div>
                                    <div class="col-12">
                                        <label for="contactMessage" class="form-label">Message *</label>
                                        <textarea class="form-control" id="contactMessage" rows="5" required=""></textarea>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary btn-lg">Send Message</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="contact-info">
                                <h3 class="mb-4">Get in touch</h3>
                                <div class="contact-item mb-4">
                                    <i class="fa fa-map-marker-alt fa-lg text-primary me-3"></i>
                                    <div>
                                        <h6 class="mb-1">Address</h6>
                                        <p class="text-muted mb-0">123 Business Street<br/>City, State 12345</p>
                                    </div>
                                </div>
                                <div class="contact-item mb-4">
                                    <i class="fa fa-phone fa-lg text-primary me-3"></i>
                                    <div>
                                        <h6 class="mb-1">Phone</h6>
                                        <p class="text-muted mb-0">+1 (555) 123-4567</p>
                                    </div>
                                </div>
                                <div class="contact-item mb-4">
                                    <i class="fa fa-envelope fa-lg text-primary me-3"></i>
                                    <div>
                                        <h6 class="mb-1">Email</h6>
                                        <p class="text-muted mb-0">info@shashastore.com</p>
                                    </div>
                                </div>
                                <div class="contact-item">
                                    <i class="fa fa-clock fa-lg text-primary me-3"></i>
                                    <div>
                                        <h6 class="mb-1">Business Hours</h6>
                                        <p class="text-muted mb-0">
                                            Monday - Friday: 9:00 AM - 6:00 PM<br/>
                                            Saturday: 10:00 AM - 4:00 PM<br/>
                                            Sunday: Closed
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>