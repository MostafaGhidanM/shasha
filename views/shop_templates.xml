<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shop Page Template -->
    <template id="shop_page_template" name="Shop Page">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- Breadcrumb -->
                <div class="breadcrumb-section">
                    <div class="container">
                        <div class="breadcrumb-nav">
                            <span class="breadcrumb-item">
                                <a href="/">Home</a>
                            </span>
                            <span class="breadcrumb-separator">/</span>
                            <span class="breadcrumb-item">Shop</span>
                        </div>
                    </div>
                </div>

                <div class="container py-4">
                    <div class="row">
                        <!-- Sidebar -->
                        <div class="col-lg-3">
                            <!-- Categories -->
                            <div class="category-sidebar">
                                <h3 class="category-title">Categories</h3>
                                <ul class="category-list">
                                    <t t-if="categories" t-foreach="categories" t-as="category">
                                        <li class="category-item">
                                            <a t-attf-href="/shop?category=#{category.id}" class="category-link">
                                                <span t-field="category.name"/>
                                                <span class="category-count" t-esc="category.product_count or 0"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <!-- Price Filter -->
                            <div class="filter-section">
                                <h4 class="filter-title">Price Range</h4>
                                <div class="price-range">
                                    <form method="get" action="/shop">
                                        <div class="price-inputs">
                                            <input type="number" name="min_price" class="price-input" placeholder="Min" t-att-value="min_price or ''"/>
                                            <input type="number" name="max_price" class="price-input" placeholder="Max" t-att-value="max_price or ''"/>
                                        </div>
                                        <input type="hidden" name="search" t-att-value="search or ''"/>
                                        <input type="hidden" name="category" t-att-value="category or ''"/>
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Apply Filter</button>
                                    </form>
                                </div>
                            </div>

                            <!-- Brand Filter -->
                            <div class="filter-section" t-if="brands">
                                <h4 class="filter-title">Brands</h4>
                                <div class="brand-filter">
                                    <t t-foreach="brands" t-as="brand">
                                        <div class="brand-item">
                                            <input type="checkbox" class="brand-checkbox" t-attf-id="brand_#{brand.id}" name="brand" t-att-value="brand.id"/>
                                            <label t-attf-for="brand_#{brand.id}" class="brand-label">
                                                <span t-field="brand.name"/>
 (                                                <span t-esc="brand.product_count or 0"/>
)
                                            </label>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Main Content -->
                        <div class="col-lg-9">
                            <!-- Shop Header -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <h1 style="font-weight: 700; color: #2c3e50;">All Products</h1>
                                    <p class="text-muted" t-if="pager">
                                        Showing <span t-esc="(pager.get('page', {}).get('current', 1) - 1) * pager.get('page', {}).get('step', 20) + 1"/>
-                                    <span t-esc="min(pager.get('page', {}).get('current', 1) * pager.get('page', {}).get('step', 20), pager.get('page', {}).get('total', 0))"/>
 
                                        of <span t-esc="pager.get('page', {}).get('total', 0)"/>
 results
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <form method="get" action="/shop" class="d-flex align-items-center gap-2">
                                    <input type="hidden" name="search" t-att-value="search or ''"/>
                                    <input type="hidden" name="category" t-att-value="category or ''"/>
                                    <select name="order" class="form-select" style="width: auto;" onchange="this.form.submit()">
                                        <option value="website_sequence desc" t-att-selected="'selected' if order == 'website_sequence desc' else None">Sort by Latest</option>
                                        <option value="list_price asc" t-att-selected="'selected' if order == 'list_price asc' else None">Price: Low to High</option>
                                        <option value="list_price desc" t-att-selected="'selected' if order == 'list_price desc' else None">Price: High to Low</option>
                                        <option value="name asc" t-att-selected="'selected' if order == 'name asc' else None">Name A-Z</option>
                                    </select>
                                </form>
                                <div class="btn-group">
                                    <button class="btn btn-outline-secondary active">
                                        <i class="fas fa-th"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary">
                                        <i class="fas fa-list"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Products Grid -->
                        <div class="products-grid">
                            <t t-if="products" t-foreach="products" t-as="product">
                                <div class="product-card" t-att-data-product-id="product.id">
                                    <div class="product-image">
                                        <t t-if="product.ribbon_id">
                                            <span t-att-class="'product-badge ' + (product.ribbon_id.html_class or '')" t-field="product.ribbon_id.name"/>
                                        </t>
                                        <a t-attf-href="/shop/product/#{slug(product)}">
                                            <img t-attf-src="/web/image/product.template/#{product.id}/image_1024" t-att-alt="product.name" loading="lazy"/>
                                        </a>
                                        <div class="product-actions">
                                            <button class="btn btn-sm btn-outline-primary wishlist-btn" t-att-data-product-id="product.id">
                                                <i class="far fa-heart"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary quick-view-btn" t-att-data-product-id="product.id">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="product-info">
                                        <h3 class="product-title">
                                            <a t-attf-href="/shop/product/#{slug(product)}" t-field="product.name"/>
                                        </h3>
                                        <div class="product-rating">
                                            <div class="stars">
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                                <i class="far fa-star"></i>
                                            </div>
                                            <span class="rating-count">(24 reviews)</span>
                                        </div>
                                        <div class="product-price">
                                            <span class="currency" t-field="product.currency_id.symbol"/>
                                            <span class="price" t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                            <t t-if="product.compare_list_price and product.compare_list_price > product.list_price">
                                                <span class="old-price">
                                                    <span t-field="product.currency_id.symbol"/>
                                                    <span t-field="product.compare_list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                </span>
                                            </t>
                                        </div>
                                        <button class="add-to-cart-btn" t-att-data-product-id="product.id">
                                            <i class="fas fa-shopping-cart"></i> Add to Cart
                                        </button>
                                    </div>
                                </div>
                            </t>

                            <!-- No Products Found -->
                            <t t-if="not products">
                                <div class="col-12 text-center py-5">
                                    <h3>No products found</h3>
                                    <p>Try adjusting your search terms or browse our categories.</p>
                                    <a href="/shop" class="btn btn-primary">Browse All Products</a>
                                </div>
                            </t>
                        </div>

                        <!-- Pagination -->
                        <nav class="mt-5" t-if="pager">
                            <t t-call="website.pager"/>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>

<!-- Category Page Template -->
<template id="category_page_template" name="Category Page" inherit_id="shop_page_template">
    <xpath expr="//span[hasclass('breadcrumb-item')][last()]" position="replace">
        <span class="breadcrumb-item">
            <a href="/shop">Shop</a>
        </span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item" t-field="category.name"/>
    </xpath>

    <xpath expr="//h1" position="replace">
        <h1 style="font-weight: 700; color: #2c3e50;" t-field="category.name"/>
    </xpath>
</template>

<!-- Product Search Results -->
<template id="product_search_results" name="Search Results">
    <t t-call="website.layout">
        <div id="wrap">
            <div class="breadcrumb-section">
                <div class="container">
                    <div class="breadcrumb-nav">
                        <span class="breadcrumb-item">
                            <a href="/">Home</a>
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-item">
                            <a href="/shop">Shop</a>
                        </span>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-item">Search Results</span>
                    </div>
                </div>
            </div>

            <div class="container py-4">
                <h1>Search Results for "<span t-esc="search or ''"/>
"</h1>
                <p class="text-muted mb-4">Found <span t-esc="len(products) if products else 0"/>
 products</p>

                <div class="products-grid" t-if="products">
                    <t t-foreach="products" t-as="product">
                        <div class="product-card" t-att-data-product-id="product.id">
                            <div class="product-image">
                                <a t-attf-href="/shop/product/#{slug(product)}">
                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_1024" t-att-alt="product.name" loading="lazy"/>
                                </a>
                            </div>
                            <div class="product-info">
                                <h3 class="product-title">
                                    <a t-attf-href="/shop/product/#{slug(product)}" t-field="product.name"/>
                                </h3>
                                <div class="product-price">
                                    <span t-field="product.currency_id.symbol"/>
                                    <span t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                </div>
                                <button class="add-to-cart-btn" t-att-data-product-id="product.id">
                                    <i class="fas fa-shopping-cart"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="text-center py-5" t-if="not products">
                    <h3>No products found</h3>
                    <p>Try adjusting your search terms or browse our categories.</p>
                    <a href="/shop" class="btn btn-primary">Browse All Products</a>
                </div>
            </div>
        </div>
    </t>
</template>
</odoo>